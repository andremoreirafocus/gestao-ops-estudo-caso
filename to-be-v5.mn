%% TO-BE v5 — decisão de autorização compactada; fluxo preservado da v4
%% Fonte: quadro-cenario-problema-farmaceutica-v3.md
%%{init: {"theme": "base", "themeVariables": {"fontSize": "20px"}}}%%

flowchart LR
    subgraph IN[ENTRADAS]
        direction TB
        I2[Plano financeiro por SKU<br/>SAP Analytics Cloud Planning]
        I3[Dados internos e<br/>sinais de mercado]
        I4[Estoques local/global e<br/>capacidade de produção]
        I5[Eventos extraordinários:<br/>concorrência, surtos, bids]
    end

    subgraph MKT[RAIA — Marketing]
        direction TB
        M1[2. Avaliar proposta inicial<br/>do AERA<br/><i>ETAPA ALTERADA</i>]
        M2[Solicitar ajuste material,<br/>justificado e comentado<br/><i>ETAPA ALTERADA</i>]
        M3[Alinhar restrições e<br/>assumir risco de perdas<br/><i>Marketing</i>]
    end

    subgraph AERA[RAIA — Sistema AERA]
        direction TB
        A1[1. Gerar forecast inicial<br/>a partir do plano financeiro por SKU<br/><i>ETAPA ALTERADA</i>]
        A2[Registrar ajuste solicitado<br/><i>ETAPA ALTERADA</i>]
        R1[Valor do ajuste supera<br/>o limite mínimo definido<br/>pelo Supply Chain Global?]
        A3[Registrar ajuste aprovado e<br/>consolidar forecast<br/><i>ETAPA ALTERADA</i>]
        N1[Registrar ajuste negado<br/>para auditoria<br/><i>ETAPA ALTERADA</i>]
        A4[Gerar métricas e análises<br/>a partir dos dados ajustados<br/><i>ETAPA ALTERADA</i>]
    end

    subgraph SCL[RAIA — Supply Chain Local]
        direction TB
        L1[3. Fazer sanity check<br/>vs. histórico e plano financeiro<br/><i>Supply Chain Local</i>]
        L2[Checar estoques e<br/>capacidade de produção<br/><i>Supply Chain Local + Global</i>]
        L3[Comunicar restrições e<br/>alinhar com Marketing<br/><i>Supply Chain Local</i>]
        L4[Enviar volumes ao<br/>Supply Chain Global<br/><i>Mensal</i>]
        L5[Definir logística e<br/>conduzir desembaraço<br/><i>Supply Chain Local</i>]
    end

    subgraph GSF[RAIA — Supply Chain Global e Fábricas]
        direction TB
        G0[Definir limite mínimo<br/>para autorização de ajustes<br/><i>ETAPA ALTERADA</i>]
        G1[4. Planejar atendimento<br/>do forecast com fábricas<br/><i>Supply Chain Global + Fábricas</i>]
        F1[Consultar estoques no SAP<br/>e produzir conforme forecast<br/><i>Fábricas</i>]
        G2[Comunicar alteração de<br/>programação ao SC Local<br/><i>Supply Chain Global</i>]
    end

    subgraph LOG[RAIA — Operador Logístico]
        direction TB
        O1[5. Transporte, desembaraço<br/>e recebimento do produto<br/><i>Operador Logístico</i>]
        O2[Produto disponível<br/>para venda]
    end

    I2 --> A1 --> M1 --> M2 --> A2 --> R1
    I3 -. base para avaliação .-> M1
    R1 -- autorizado --> A3
    R1 -- negado --> N1
    A3 --> L1 --> L2 --> L3 --> M3 --> L4 --> G1 --> F1 --> L5 --> O1 --> O2
    A3 -. dados ajustados .-> A4 --> MET[Métricas e análises:<br/>D&O, Lost Sales, riscos e<br/>assertividade vs. plano financeiro]

    I2 -. referência .-> L1
    I4 -. referência .-> L2
    G0 -. define limite .-> A3
    G1 --> G2 --> L3

    E1[Buscar alternativas para<br/>capturar oportunidade ou mitigar risco<br/><i>Supply Chain Local + Global</i>]
    I5 -. evento .-> E1
    E1 -. alternativa / mitigação .-> G1

    classDef changed fill:#DCFCE7,stroke:#16A34A,color:#14532D,stroke-width:2px;
    classDef unchanged fill:#F3F4F6,stroke:#475569,color:#111827;
    classDef input fill:#E8F3FF,stroke:#2563EB,color:#111827;
    classDef output fill:#DCFCE7,stroke:#16A34A,color:#111827;
    classDef metric fill:#F3E8FF,stroke:#9333EA,color:#581C87;
    class I2,I3,I4,I5 input;
    class A1,A2,A3,N1,A4,M1,M2,G0,R1 changed;
    class M3,L1,L2,L3,L4,L5,G1,F1,G2,O1,E1 unchanged;
    class O2 output;
    class MET metric;
